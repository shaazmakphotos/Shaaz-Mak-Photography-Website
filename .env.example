# Supabase project credentials (find these in Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional: public CDN base URL placed in front of Supabase Storage (e.g. Cloudflare).
# When set, all photo URLs read from the database are rewritten to load from this host
# instead of `<project>.supabase.co`. Leave blank to bypass the CDN.
# Example: https://cdn.shaazmakphotography.com
VITE_CDN_BASE=
